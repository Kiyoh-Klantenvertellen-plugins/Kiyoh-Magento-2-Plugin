{
    "name": "kiyoh/reviews",
    "description": "Kiyoh Reviews integration for Magento 2 - Shop and Product Reviews",
    "type": "magento2-module",
    "license": "proprietary",
    "authors": [
        {
            "name": "Kiyoh",
            "email": "info@kiyoh.com"
        }
    ],
    "require": {
        "php": ">=7.2.0",
        "magento/framework": "^100.1 || ^101.0 || ^102.0 || ^103.0",
        "magento/module-store": "^100.1 || ^101.0",
        "magento/module-customer": "^101.0 || ^102.0 || ^103.0",
        "magento/module-sales": "^100.1 || ^101.0 || ^102.0 || ^103.0",
        "magento/module-catalog": "^101.0 || ^102.0 || ^103.0 || ^104.0",
        "magento/module-widget": "^100.1 || ^101.0",
        "magento/module-config": "^100.1 || ^101.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "magento/magento2-functional-testing-framework": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Kiyoh\\Reviews\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kiyoh\\Reviews\\Test\\": "Test/"
        }
    },
    "scripts": {
        "test": "phpunit -c Test/phpunit.xml",
        "test-unit": "phpunit -c Test/phpunit.xml --testsuite=\"Unit Tests\"",
        "test-integration": "phpunit -c Test/phpunit.xml --testsuite=\"Integration Tests\"",
        "test-coverage": "phpunit -c Test/phpunit.xml --coverage-html Test/coverage"
    }
}
